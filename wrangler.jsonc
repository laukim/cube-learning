{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3x3coach",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // `/` is the timer home. /timer is the canonical timer URL; html_handling redirects /timer.html and /timer/ there.
    "run_worker_first": ["/api/*", "/", "/index.html", "/timer", "/timer.html"]
  },
  // Rewrites worker/app-version.js to vX.XX from the commit count before bundling.
  "build": {
    "command": "node scripts/write-app-version.mjs"
  },
  // Each deploy still gets a new version id, used as the page etag.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3x3coach-times",
      "database_id": "99a52c87-8c73-4cc0-8791-f03be849d515"
    }
  ]
}
