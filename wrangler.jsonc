{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3x3coach",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3x3coach-times",
      "database_id": "99a52c87-8c73-4cc0-8791-f03be849d515"
    }
  ]
}
